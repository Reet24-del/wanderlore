# Copy to .env locally. Never commit real values.
# Local defaults: Gemma through Ollama, Kokoro narration.
WANDERLORE_HOSTED=0
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
SENTRY_DSN=
TIGER_DATABASE_URL=

# Optional online Gemma; enable these only for connected narration.
# WANDERLORE_NARRATOR=google
# WANDERLORE_MODEL=gemma-4-26b-a4b-it
GOOGLE_API_KEY=
# Hosted pairing is server-side. Use your own private code, never the owner's.
# WANDERLORE_PAIR_CODE=
